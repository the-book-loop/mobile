<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mobile.Views.LandingPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <ContentPage.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#011166"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="#011166"/>
            <Setter Property="BorderColor" Value="#011166"/>
            <Setter Property="BorderWidth" Value="2"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </ContentPage.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="WaveRow" Height="0.7*" />
            <RowDefinition x:Name="ContentRow" Height="0.3*" />
        </Grid.RowDefinitions>

        <Path Grid.Row="0"
              x:Name="WavePath"
              Fill="#011166"
              Aspect="Fill"
               Data="M0,0 L0,100 C150,150 300,50 500,100 L500,0 Z" />

        <Image x:Name="BookLogo"
               Source="bookloop_logo_landing.png"
                   HeightRequest="170"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Margin="0,0,0,30"/>
        <VerticalStackLayout Grid.Row="1"
                      Padding="30"
                      Spacing="20"
                      VerticalOptions="Center">
            <Button x:Name="CreateAccountButton" Text="Create account" Style="{StaticResource SecondaryButton}" Clicked="OnCreateAccountClicked" Pressed="OnButtonPressed" Released="OnButtonReleased" WidthRequest="250"/>
            <Button x:Name="SignInButton" Text="Sign in" Style="{StaticResource SecondaryButton}" Clicked="OnSignInClicked" Pressed="OnButtonPressed" Released="OnButtonReleased" WidthRequest="250"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
