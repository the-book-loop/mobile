<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:mobile.Views"
    xmlns:local="clr-namespace:mobile"
    Title="mobile">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:LandingPage}"
        Route="LandingPage" />
    
    <ShellContent
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"
        IsVisible="False"/>

    <ShellContent
     ContentTemplate="{DataTemplate views:CreateAccountPage}"
     Route="CreateAccountPage"
     IsVisible="False"/>

    <TabBar Route="MainApp">
        <ShellContent
            Title="Discover"
            Icon="discover_icon.png"
            ContentTemplate="{DataTemplate views:MainPage}" />
        <ShellContent
            Title="Matches"
            Icon="matches_icon.png"
            ContentTemplate="{DataTemplate views:MatchesPage}" />
        <ShellContent
            Title="Chat"
            Icon="chat_icon.png"
            ContentTemplate="{DataTemplate views:ChatPage}" />
        <ShellContent
            Title="Profile"
            Icon="profile_icon.png"
            ContentTemplate="{DataTemplate views:AccountPage}" />
    </TabBar>
</Shell>
